# ShramSetu Backend Configuration
# Copy this file to .env and fill in your values

# --- App ---
APP_NAME=ShramSetu
ENV=development
DEBUG=true

# --- Database ---
# SQLite (default for development)
DATABASE_URL=sqlite:///./shramsetu.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/shramsetu
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# --- Auth / JWT ---
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_super_secret_dev_key_only
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- HTTPS / SSL ---
# SSL_CERTFILE=/path/to/cert.pem
# SSL_KEYFILE=/path/to/key.pem
# USE_SSL=false

# --- File Storage ---
# "local" for development, "s3" for production
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# S3 Configuration (for production)
# S3_BUCKET_NAME=your-bucket-name
# S3_REGION=auto
# S3_ENDPOINT_URL=https://your-endpoint.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# --- Groq (LLM + STT) ---
# Get a free API key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAISS_INDEX_DIR=./rag/index
RAG_SOURCE_DOCS_DIR=./rag/sample_docs
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.02

# --- Firebase Cloud Messaging (Push Notifications) ---
# Create a Firebase project at console.firebase.google.com
# FCM_SERVER_KEY=your_fcm_server_key
# FCM_PROJECT_ID=your_project_id

# --- Email Notifications (SMTP) ---
# NOTIFY_AUTHORITIES_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM_EMAIL=noreply@shramsetu.local
# SMTP_USE_TLS=true

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
