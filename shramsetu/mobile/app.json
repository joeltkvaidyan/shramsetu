{
  "expo": {
    "name": "ShramSetu",
    "slug": "shramsetu",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1a7c54"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.shramsetu.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ShramSetu uses the microphone so you can ask the AI Welfare Assistant questions by voice."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a7c54"
      },
      "package": "org.shramsetu.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE", "RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:8000/api/v1"
    }
  }
}
