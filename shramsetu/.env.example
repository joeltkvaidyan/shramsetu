# Used by docker-compose.yml. Copy to .env in the project root.

# REQUIRED — generate a real one, e.g.: openssl rand -hex 32
# docker-compose runs in ENV=production by default, which refuses to start
# with a placeholder/short JWT_SECRET_KEY (see backend/app/main.py).
JWT_SECRET_KEY=

# Free tier: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional: override the Postgres password (defaults to "shramsetu")
POSTGRES_PASSWORD=

# Optional: grievance -> authority email forwarding. Leave SMTP_HOST empty
# to just log emails to the backend console (free, no account needed).
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
LABOUR_DEPARTMENT_EMAIL=labour-dept@example.gov.in
POLICE_DEPARTMENT_EMAIL=police-cell@example.gov.in

# Optional: use S3-compatible storage instead of the local volume
# (recommended for real production — see backend/.env.example)
STORAGE_BACKEND=local
