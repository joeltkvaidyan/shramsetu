[TEMPLATE]
# ShramSetu — ROOT .env (docker compose interpolation source)
#
# docker-compose.yml reads THIS file (the .env next to it) to interpolate
# every bare env name in its `environment:` blocks — GROQ_API_KEY,
# JWT_SECRET_KEY, BOOTSTRAP_ADMIN_PASSWORD, ... If a key is missing here it
# lands in the container as an empty string (and the server's production
# guard refuses to boot for the security-critical ones).
#
#   cp .env.example .env   # then fill in real values
#
# The root .env is gitignored. Per-service .env files (server/.env,
# ai-service/.env) are NOT read by the containers — compose's
# `environment:` block is the only runtime source. They remain useful for
# running the services outside Docker (uvicorn / npm run dev).
#
# ---------------------------------------------------------------------------
# REQUIRED — the server refuses to boot in production without these
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=                  # openssl rand -hex 32
BOOTSTRAP_ADMIN_PASSWORD=        # admin (ADMIN001) login; openssl rand -base64 18
DOC_MASTER_KEY=                  # 32 raw bytes, base64:
                                 # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_INTERNAL_KEY=                 # must match on server + ai-service:
                                 # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MONGO_INITDB root/shramsetu123   # (not a key: hardcoded in docker-compose.yml to
                                 # match the server's MONGODB_URI — change both
                                 # together before exposing the DB port)
#
# ---------------------------------------------------------------------------
# Provider keys (ai-service) — degraded-but-honest fallbacks without them
# ---------------------------------------------------------------------------
GROQ_API_KEY=                    # primary LLM — https://console.groq.com
GROQ_MODEL=openai/gpt-oss-120b   # must be a reasoning-capable model (code sends reasoning_effort)
HF_TOKEN=                        # REQUIRED: gated models (IndicParler-TTS,
                                 # IndicTrans2) — click "Agree" once on each
                                 # HF model page with the token's account
GEMINI_API_KEY=                  # optional LLM fallback (Groq -> Gemini -> JSON)
GOOGLE_API_KEY=                  # optional Google Translate for query translation
#
# ---------------------------------------------------------------------------
# Server tuning (all optional; defaults shown)
# ---------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost,http://localhost:5173
#   Same-origin via the nginx proxy, so this only matters for direct API
#   calls — append the public https://<domain> once one exists.
# OTP_ECHO_ENABLED=false          # forced false inline in compose (production guard)
# SEED_DEMO_DATA=false            # forced false inline in compose
#
# ---------------------------------------------------------------------------
# History
# ---------------------------------------------------------------------------
# Earlier revisions of this file claimed there is deliberately NO root .env
# and listed a removed Postgres/backend stack (POSTGRES_PASSWORD, STORAGE_BACKEND,
# SMTP_*, backend/app/main.py). The architecture is now Node API + MongoDB with
# docker compose, and compose has always read the root .env — the old template
# was simply wrong.
