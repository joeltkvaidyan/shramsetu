# Used by docker-compose.yml. Copy to .env in the project root and fill in.
# NEVER commit a real .env or real keys (a live Groq key was once committed
# to this template and had to be revoked — do not repeat that).

# REQUIRED — generate a real one, e.g.: openssl rand -hex 32
# docker-compose runs in ENV=production by default, which refuses to start
# with a placeholder/short JWT_SECRET_KEY (see backend/app/main.py).
JWT_SECRET_KEY=

# REQUIRED — no insecure default database password.
POSTGRES_PASSWORD=

# Free tier: https://console.groq.com — paste your own key here.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# OTP delivery (Fast2SMS India). REQUIRED in production — the backend
# refuses to boot in production with OTPs going only to the console log.
# Leave empty for local dev (OTP is printed to the backend console).
FAST2SMS_API_KEY=
OTP_EXPIRE_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# First-run superadmin for the government portal (optional). If set, this
# account is created idempotently at startup; if empty, provision admins
# via a superadmin-protected /auth/government/register call instead.
BOOTSTRAP_ADMIN_EMPLOYEE_ID=
BOOTSTRAP_ADMIN_PASSWORD=

# Browser origins allowed to call the API. Production refuses to boot with
# no explicit origin. Wildcards like http://192.168.*:5173 are allowed for
# LAN development only.
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Optional Redis for rate limiting shared across app replicas.
REDIS_URL=

# Optional: grievance -> authority email forwarding. Leave SMTP_HOST empty
# to log emails to the backend console instead of sending (dev/demo).
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
# Replace with real department mailboxes before relying on forwarding.
LABOUR_DEPARTMENT_EMAIL=
POLICE_DEPARTMENT_EMAIL=

# Optional: use S3-compatible storage instead of the local volume
# (recommended for real production — see backend/.env.example)
STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
