# ShramSetu AI service — environment
# Copy to ai-service/.env and fill in. NEVER commit the real .env.
#
# Every key below exists in app/core/config.py. This service is stateless: it
# owns RAG (FAISS + embeddings + Groq), speech-to-text (faster-whisper) and
# text-to-speech (Sarvam/Google). Auth, OTP, database, uploads and all CRUD
# live in the Node server, which calls this service over HTTP with the
# AI_INTERNAL_KEY below. Keys that used to live here but are read by neither
# service (DATABASE_URL/SQLite/Postgres, FAST2SMS_API_KEY, OTP_*,
# BOOTSTRAP_ADMIN_*, REDIS_URL, SMTP_*, S3_*, JWT_SECRET_KEY, CORS_ORIGINS,
# UPLOAD_DIR) were removed in the Node migration and are gone for good.

# --- App ---
APP_NAME=ShramSetu
ENV=development
DEBUG=true

# --- Service-to-service auth ---
# Shared secret: the Node server sends it as X-Internal-Key on every request
# except GET /health. MUST match AI_INTERNAL_KEY in server/.env.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_INTERNAL_KEY=
# Per-IP request cap per minute (in-memory; fine for the single-instance demo).
AI_RATE_LIMIT_PER_MIN=120

# --- Groq (LLM that writes the grounded answers) ---
# Free key: console.groq.com . Without it, retrieval still runs and the
# service answers with its honest "no grounded answer" reply — it never
# pretends the LLM answered.
GROQ_API_KEY=
# NOTE: llama-3.3-70b-versatile (the historical default) has been retired by
# Groq. Use a currently served model, e.g. openai/gpt-oss-120b.
GROQ_MODEL=llama-3.3-70b-versatile

# --- Sarvam AI (TTS + machine translation, free tier) ---
# Key: dashboard.sarvam.ai . Required for TTS_PROVIDER=sarvam and for the
# Sarvam MT engine; without it TTS falls back to Google, then to an error.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh          # or ananya, abhir, aditya, ...

# --- Google Cloud (optional; needs billing enabled on the project) ---
# Plain API keys, no SDK. GOOGLE_API_KEY covers Cloud TTS + Speech-to-Text;
# GOOGLE_TRANSLATE_API_KEY covers Cloud Translation v2 (fastest query
# translation). With neither set, the local IndicTrans2 / NLLB engines run.
GOOGLE_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# --- Voice: speech-to-text ---
# STT is fully LOCAL (faster-whisper, in-process, no key, no rate limit,
# audio never leaves the machine). There is no STT_PROVIDER setting because
# there is only one engine.
WHISPER_MODEL_SIZE=small        # tiny/base/small/medium/large-v3
WHISPER_DEVICE=cpu              # or cuda
WHISPER_COMPUTE_TYPE=int8
# Stronger model for NON-ENGLISH requests only (lazy-loaded, cached alongside
# WHISPER_MODEL_SIZE). `small` collapses into repeated-syllable garbage on
# Malayalam/Tamil — measured on the 4-core box: small = unusable, medium =
# accurate (Tamil near-perfect). Costs latency: ~25s vs ~6s per 4s clip.
# Empty = every language uses WHISPER_MODEL_SIZE.
WHISPER_INDIC_MODEL=medium
MAX_AUDIO_MB=15

# --- Voice: text-to-speech ---
# "sarvam" = Bulbul v3 neural voices (recommended); "google" = Cloud TTS.
# Fallback order: sarvam -> google. Local Coqui/gTTS were removed.
TTS_PROVIDER=sarvam

# --- Query translation (improves Indic retrieval recall) ---
# IndicTrans2 is license-gated: accept once at
# https://huggingface.co/ai4bharat/indictrans2-indic-en-1B with a free
# account, then `huggingface-cli login`. Until then NLLB-200 is used.
TRANSLATION_MODEL=ai4bharat/indictrans2-indic-en-1B
TRANSLATION_ENABLED=true
TRANSLATION_ENGINE=auto          # auto | indictrans2 | nllb
TRANSLATION_QUANTIZE=true        # int8: ~1GB instead of ~4GB on CPU
TRANSLATION_FALLBACK_MODEL=facebook/nllb-200-distilled-600M
TRANSLATE_HTTP_TIMEOUT=20

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAISS_INDEX_DIR=./rag/index
RAG_SOURCE_DOCS_DIR=./rag/sample_docs
RAG_TOP_K=6
# Similarity floor for accepting a chunk. Eval-justified: off-topic and
# prompt-injection questions score <= 0.42, genuine hits >= 0.47
# (see eval/RESULTS.md). Lowering it makes the assistant answer from
# irrelevant chunks — do not tune this down to "improve" recall.
RAG_MIN_SIMILARITY=0.45

# --- Cold start ---
# How long /ask waits for the boot warm-up (embedding model + FAISS index)
# to finish before answering with a fast 503 instead. The Node server aborts
# at AI_TIMEOUT_MS (120s) in server/.env, so keeping this below that is what
# turns a would-be proxy timeout into a quick "still starting, try again".
# The AI service reports warming vs ready on GET /health/ready; set 0 to
# refuse questions outright while warming.
WARMUP_WAIT_SECONDS=90

# --- Languages served by the platform ---
SUPPORTED_LANGUAGES=["en","hi","bn","te","ta","ml"]
