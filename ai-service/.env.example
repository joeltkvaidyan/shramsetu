# ShramSetu Backend Configuration
# Copy this file to .env and fill in your values

# --- App ---
APP_NAME=ShramSetu
ENV=development
DEBUG=true

# --- Database ---
# SQLite (default for development)
DATABASE_URL=sqlite:///./shramsetu.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/shramsetu
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# --- Auth / JWT ---
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_super_secret_dev_key_only
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OTP delivery + policy ---
# Leave FAST2SMS_API_KEY empty for dev (OTP printed to the server console).
# Production MUST set a real provider — the app refuses to boot otherwise.
FAST2SMS_API_KEY=
OTP_EXPIRE_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_ECHO_ENABLED=false

# --- First-run superadmin (optional, government portal) ---
BOOTSTRAP_ADMIN_EMPLOYEE_ID=12345678
BOOTSTRAP_ADMIN_PASSWORD=12345678

# --- Rate limiting ---
# Optional Redis backend (multi-instance deployments). Empty = in-memory.
REDIS_URL=

# --- HTTPS / SSL ---
# SSL_CERTFILE=/path/to/cert.pem
# SSL_KEYFILE=/path/to/key.pem
# USE_SSL=false

# --- File Storage ---
# "local" for development, "s3" for production
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# S3 Configuration (for production)
# S3_BUCKET_NAME=your-bucket-name
# S3_REGION=auto
# S3_ENDPOINT_URL=https://your-endpoint.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# --- Groq (LLM for RAG answers + FREE hosted Whisper STT) ---
# Get a free API key at console.groq.com and keep it in your local .env
# (gitignored). NEVER commit a real key to this template.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3   # only used when STT_PROVIDER=groq

# --- Sarvam AI (Indian-language-native STT + natural TTS, free tier) ---
# Free key at dashboard.sarvam.ai. Powers STT_PROVIDER=sarvam (Saaras v4,
# best accuracy on Indic/code-mixed speech) and TTS_PROVIDER=sarvam
# (Bulbul v3 neural voices — the recommended TTS for this project).
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh          # or ananya, abhir, aditya, ...

# --- Google Cloud speech (optional; needs billing on the project) ---
# Plain API key with Cloud Speech-to-Text + Text-to-Speech APIs enabled.
GOOGLE_API_KEY=

# --- Voice: speech-to-text ---
# STT is fully LOCAL (faster-whisper, in-process, no key, no rate limit).
# "local" is the only supported value — audio never leaves the machine.
STT_PROVIDER=local
WHISPER_MODEL_SIZE=small        # tiny/base/small/medium/large-v3
WHISPER_DEVICE=cpu              # or cuda
WHISPER_COMPUTE_TYPE=int8
# Stronger model used ONLY for non-English requests (lazy-loaded, cached
# alongside WHISPER_MODEL_SIZE). `small` collapses into repeated-syllable
# garbage on Malayalam/Tamil — measured: small = unusable, medium = accurate
# (Tamil near-perfect). Costs latency on CPU: ~25s vs ~6s for a 4s clip.
# Empty = every language uses WHISPER_MODEL_SIZE.
WHISPER_INDIC_MODEL=medium
MAX_AUDIO_MB=15

# --- Voice: text-to-speech ---
# "sarvam" = Bulbul v3 natural voices (free tier) — recommended default
# "coqui"  = offline Coqui fairseq VITS (no key; also the fallback engine)
# "google" = Google Cloud TTS (GOOGLE_API_KEY)
# "gtts"   = Google Translate TTS (online last resort)
TTS_PROVIDER=sarvam

# --- Query translation (IndicTrans2, improves Indic retrieval) ---
# The official ai4bharat models are license-gated: accept once at
# https://huggingface.co/ai4bharat/indictrans2-indic-en-1B with a free
# account, then run `huggingface-cli login`. Until then the chatbot still
# works — Indic queries are embedded directly without translation.
TRANSLATION_MODEL=ai4bharat/indictrans2-indic-en-1B
TRANSLATION_ENABLED=true

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAISS_INDEX_DIR=./rag/index
RAG_SOURCE_DOCS_DIR=./rag/sample_docs
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.02

# --- Firebase Cloud Messaging (Push Notifications) ---
# Create a Firebase project at console.firebase.google.com
# FCM_SERVER_KEY=your_fcm_server_key
# FCM_PROJECT_ID=your_project_id

# --- Email Notifications (SMTP) ---
# NOTIFY_AUTHORITIES_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM_EMAIL=noreply@shramsetu.local
# SMTP_USE_TLS=true

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
